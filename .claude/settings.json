{
  "permissions": {
    "deny": [
      "Read(./node_modules/**)",
      "Read(./**/node_modules/**)",
      "Read(./dist/**)",
      "Read(./build/**)",
      "Read(./.next/**)",
      "Read(./coverage/**)",
      "Read(./**/package-lock.json)",
      "Read(./**/*.min.js)",
      "Read(./**/*.map)"
    ]
  },
  "env": {
    "BASH_MAX_OUTPUT_LENGTH": "15000",
    "DISABLE_NON_ESSENTIAL_MODEL_CALLS": "1"
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  },
  "enabledPlugins": {
    "caveman@caveman": true
  }
}
